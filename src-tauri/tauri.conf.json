{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeAtlas",
  "version": "0.1.0",
  "identifier": "dev.codeatlas.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CodeAtlas",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Visual repository explorer",
    "longDescription": "Explore repository structure, dependencies, languages, TODOs and Git activity with an interactive graph.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
